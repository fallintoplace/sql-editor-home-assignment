{
  "name": "clickstudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start:production": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "npm run test:core && npm run test:workspace",
    "test:core": "tsc -p tsconfig.core.json && node --test tests/core/*.test.mjs",
    "test:integration": "tsx --env-file-if-exists=.env --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:core": "playwright test tests/e2e/core-workflows.spec.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts",
    "eval:assistant": "tsx --env-file-if-exists=.env scripts/eval-assistant.ts",
    "init:env": "node scripts/init-env.mjs",
    "db:setup": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test:workspace": "tsc -p tsconfig.workspace.json && node --test tests/workspace/*.test.mjs"
  },
  "dependencies": {
    "@clickhouse/click-ui": "^0.12.0",
    "@clickhouse/client": "^1.12.0",
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-sql": "^6.9.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.203.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.203.0",
    "@tanstack/react-query": "^5.83.0",
    "d3": "^7.9.0",
    "d3-dag": "^1.2.2",
    "echarts": "^6.0.0",
    "express": "^5.1.0",
    "openai": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
