{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [],
    "rootDir": ".",
    "outDir": ".workspace-build",
    "noEmitOnError": true
  },
  "include": [
    "web/workspace-state.ts",
    "web/workspace-persistence.ts",
    "web/demo-preview.ts",
    "web/sql-examples.ts",
    "web/sql-examples-locales.ts",
    "shared/evidence.ts",
    "shared/workspace-view.ts",
    "web/local-files.ts",
    "shared/result-columns.ts",
    "shared/schema-browser.ts"
  ]
}
